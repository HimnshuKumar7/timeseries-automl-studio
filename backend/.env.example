# Neon (or any) Postgres connection string — same value that was in
# Next.js's DATABASE_URL env var.
DATABASE_URL=postgres://user:password@host/dbname?sslmode=require

# Same secret that was in Next.js's JWT_SECRET. Existing user sessions
# will only stay valid if you reuse the same secret.
JWT_SECRET=change-me-to-a-long-random-string

# Comma-separated list of frontend origins allowed to send cookies.
CORS_ORIGINS=http://localhost:5173

# "production" enables Secure cookies (requires HTTPS).
ENVIRONMENT=development
